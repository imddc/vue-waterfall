{
  "name": "vue-waterfall",
  "version": "0.0.1",
  "description": "a vue waterfall plugin",
  "keywords": [
    "vue",
    "vue-waterfall",
    "waterfall"
  ],
  "scripts": {
    "prepare": "husky install",
    "commitlint": "commitlint --edit",
    "lint": "oxlint && eslint \"**/*.vue\" --max-warnings=0",
    "lint:fix": "oxlint --fix && eslint --fix \"**/*.vue\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "wf": "pnpm --filter waterfall-vue",
    "wf:build": "pnpm wf build",
    "example": "pnpm --filter @vue-waterfall/example",
    "example:dev": "pnpm example dev",
    "example:build": "pnpm wf:build && pnpm example build",
    "example:preview": "pnpm example preview"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@types/node": "^20.12.7",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.25.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "pnpm": "^8.15.7"
  },
  "lint-staged": {
    "*.{ts,js,jsx,vue}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
