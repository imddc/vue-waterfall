{
  "name": "vue-waterfall-repo",
  "version": "0.0.1",
  "private": true,
  "description": "a vue waterfall plugin",
  "keywords": [
    "vue",
    "vue-waterfall",
    "waterfall"
  ],
  "scripts": {
    "prepare": "husky install",
    "commitlint": "commitlint --edit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "wf": "pnpm --filter vue-waterfall",
    "wf:build": "pnpm wf build",
    "example": "pnpm --filter @vue-waterfall/example",
    "example:dev": "pnpm example dev",
    "example:build": "pnpm wf:build && pnpm example build",
    "example:preview": "pnpm example preview"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.2.1",
    "@types/node": "^20.12.7",
    "eslint": "^9.35.0",
    "eslint-plugin-format": "^1.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run format"
  },
  "lint-staged": {
    "*.{ts,js,jsx,vue}": [
      "eslint",
      "prettier --write"
    ]
  }
}
